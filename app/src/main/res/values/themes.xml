<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.MathKids" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:statusBarColor">@color/bg_gradient_start</item>
        <item name="android:navigationBarColor">@color/bg_gradient_end</item>
        <item name="android:windowBackground">@color/white</item>
    </style>

    <style name="Theme.MathKids.Splash" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:statusBarColor">@color/splash_bg</item>
        <item name="android:navigationBarColor">@color/splash_bg</item>
        <item name="android:windowBackground">@color/splash_bg</item>
    </style>

    <style name="LevelCardStyle">
        <item name="android:layout_marginBottom">16dp</item>
        <item name="android:padding">20dp</item>
        <item name="android:foreground">?android:attr/selectableItemBackground</item>
    </style>

    <style name="OptionButton" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textSize">24sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:padding">16dp</item>
        <item name="cornerRadius">16dp</item>
        <item name="strokeColor">@color/option_stroke</item>
        <item name="strokeWidth">2dp</item>
        <item name="backgroundTint">@color/option_bg</item>
    </style>
</resources>
